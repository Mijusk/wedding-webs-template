# Variables de entorno de WeddingWebs.
# En Vercel: Settings › Environment Variables. En local: copia este archivo como .env.local (no se sube a git).
# Guía paso a paso: docs/SUPABASE.md

# ── Imprescindibles (Supabase › Project Settings) ─────────────────────────────
# URL del proyecto: https://<algo>.supabase.co
SUPABASE_URL=
# Clave publicable (sb_publishable_…; o la antigua "anon", que empieza por eyJ). Va al navegador del panel.
SUPABASE_ANON_KEY=
# Clave secreta (sb_secret_…; o la antigua "service_role"). SOLO en el servidor: márcala como "Sensitive" en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionales ────────────────────────────────────────────────────────────────
# Dirección pública de la web (para enlaces y tarjetas de WhatsApp). Si falta, se usa la del navegador.
SITE_URL=

# Avisos de leads nuevos a Luis
NOTIFY_EMAIL=
# Emails (Resend: resend.com). Sin clave no se envía nada y queda apuntado como "simulado".
RESEND_API_KEY=
EMAIL_FROM="WeddingWebs <hola@tudominio.es>"
# Aviso al móvil por Telegram (crea un bot con @BotFather y pon aquí su token y tu chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transición: copia de cada lead en la hoja de Google de siempre (la URL del Apps Script de integrations/leads.gs)
LEADS_SHEET_ENDPOINT=
